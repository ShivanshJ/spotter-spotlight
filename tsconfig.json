{
    "compilerOptions": {
        "strict": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "strictNullChecks": true,
        "target": "ES2022",
        "moduleResolution": "Node10",         // ✅ Modern module resolution
        "module": "ESNext",                     // ✅ Match ESM build
        "declaration": true,
        "isolatedModules": true,
        "noEmit": true,
        "outDir": "dist",
        "allowJs": true,
        "lib": ["esnext", "dom", "dom.iterable"],
    },
    "include": ["src"],
    "exclude": ["node_modules", "examples/spotter-demo", "build","dist", "**/*.test.ts"]
}