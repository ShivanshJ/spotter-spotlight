{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "moduleResolution": "Node10",
    "module": "ESNext",
    "declaration": true,
    "isolatedModules": true,
    "noEmit": true,
    "outDir": "dist",
    "lib": ["esnext", "dom", "dom.iterable"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/__fixtures__/**", "**/*.test.ts"]
}
