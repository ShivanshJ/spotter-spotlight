{
  "version": "1",
  "routes": [
    {
      "path": "/settings",
      "description": "Account settings hub",
      "selectors": {}
    },
    {
      "path": "/settings/billing",
      "description": "Manage subscription and payment",
      "title": "Billing",
      "reachableFrom": [
        "/settings"
      ],
      "selectors": {},
      "actions": [
        {
          "name": "change_plan",
          "description": "Upgrade or downgrade subscription plan",
          "selector": "[data-testid=\"change-plan\"]"
        },
        {
          "name": "download_invoice",
          "description": "Download an invoice PDF",
          "selector": "[aria-label=\"Download invoice\"]"
        }
      ]
    },
    {
      "path": "/rewards",
      "description": "Points balance and rewards history",
      "selectors": {}
    },
    {
      "path": "/settings/appearance",
      "description": "Theme and display preferences",
      "selectors": {
        "themeToggle": "[data-testid=\"theme-toggle\"]"
      }
    },
    {
      "path": "/paywall",
      "description": "Upgrade prompt shown when a feature needs a paid plan",
      "navigable": false,
      "note": "Users are sent here by the app; it is not a page they ask for",
      "selectors": {}
    }
  ],
  "actions": [
    {
      "intent": "get user points balance",
      "type": "api",
      "endpoint": "GET /api/user/rewards",
      "auth": "session"
    }
  ],
  "mcpServers": []
}
